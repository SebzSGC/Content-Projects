# --- IA (selección y verificación de historias) ---
# Proveedor: anthropic | openai | gemini | openai_compatible
#   anthropic          → Claude. Clave en ANTHROPIC_API_KEY (o perfil de `ant auth login`)
#   openai             → OpenAI. Clave en OPENAI_API_KEY
#   gemini             → Google Gemini. Clave en GEMINI_API_KEY
#   openai_compatible  → Groq, OpenRouter, DeepSeek, Ollama, LM Studio, vLLM… (requiere CLIPS_LLM_BASE_URL)
#     Groq:      CLIPS_LLM_BASE_URL=https://api.groq.com/openai/v1
#     OpenRouter: CLIPS_LLM_BASE_URL=https://openrouter.ai/api/v1
#     Ollama:    CLIPS_LLM_BASE_URL=http://localhost:11434/v1
# Las claves viven solo en el worker; nunca pasan por el navegador.
CLIPS_LLM_PROVIDER=anthropic
# Vacío = modelo por defecto del proveedor (claude-opus-5-5, gpt-4.1, gemini-2.5-flash)
CLIPS_LLM_MODEL=
CLIPS_LLM_BASE_URL=
# Clave genérica; si está vacía se usa la variable propia del proveedor
CLIPS_LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# 0 si el modelo no acepta imágenes: la verificación usará solo la transcripción
CLIPS_LLM_VISION=1
# Solo lo usa Claude (low | medium | high | xhigh | max)
CLIPS_LLM_EFFORT=high
CLIPS_VERIFY_TOP_K=10

# --- Servidor ---
CLIPS_HOST=127.0.0.1
CLIPS_PORT=8790
CLIPS_DATA_DIR=./data

# --- FFmpeg ---
CLIPS_FFMPEG=ffmpeg
CLIPS_FFPROBE=ffprobe
CLIPS_NVENC=1
# Carpeta con Montserrat/Poppins (p. ej. vidforge/apps/web/public/fonts/subtitles del monorepo)
CLIPS_FONTS_DIR=
CLIPS_TITLE_FONT=Montserrat ExtraBold
CLIPS_CAPTION_FONT=Montserrat ExtraBold

# --- Modelos de análisis ---
# https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
CLIPS_FACE_LANDMARKER_MODEL=./models/face_landmarker.task
CLIPS_TORCH_DEVICE=cuda
CLIPS_DEMUCS=1
CLIPS_DEMUCS_MODEL=htdemucs_ft
CLIPS_WHISPER_MODEL=large-v3-turbo
CLIPS_WHISPER_DEVICE=auto
CLIPS_WHISPER_COMPUTE=default
CLIPS_PROXY_HEIGHT=480
CLIPS_PROXY_FPS=10

# --- Kick ---
CLIPS_KICK_ANALYSIS_HEIGHT=480
CLIPS_KICK_RENDER_HEIGHT=1080
# cookies.txt exportado del navegador, solo para VODs de suscriptores
CLIPS_KICK_COOKIES=

# --- Forma de los clips ---
CLIPS_MIN_SEC=20
CLIPS_MAX_SEC=90
